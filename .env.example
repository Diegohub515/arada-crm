# Copia este archivo como .env.local (en tu compu) o pega estas variables en Vercel → Settings → Environment Variables.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Llave secreta: solo en el servidor. NUNCA la compartas ni la pongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Zernio (zernio.com/dashboard → API keys) ---
ZERNIO_API_KEY=
ZERNIO_API_URL=https://zernio.com/api
# Inventa una frase larga y pégala igual en Zernio → Webhooks → Secret
ZERNIO_WEBHOOK_SECRET=

# --- Entrada de leads (Zapier, Google Ads, landings) ---
# Inventa otra frase larga. Va en la URL del webhook: /api/webhooks/leads?token=ESTA_FRASE
LEADS_WEBHOOK_TOKEN=

# --- IA (opcional: sugerir respuestas y analizar gastos) ---
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo del agente que contesta los chats solo (rápido y económico)
ANTHROPIC_MODEL_AGENTE=claude-haiku-5-5

# --- WhatsApp por Zernio (cuando el número ya esté conectado en Zernio) ---
# "zernio" = el bot corre en el CRM y todo WhatsApp va por Zernio. Sin esta variable sigue por Zapier.
WHATSAPP_VIA=
# Opcional: id de la cuenta de WhatsApp en Zernio (si no, el CRM la busca solo)
ZERNIO_WHATSAPP_ACCOUNT_ID=
# Modelo del bot de WhatsApp (el mismo que usaba Zapier)
ANTHROPIC_MODEL_BOT=claude-haiku-4-5-20251001
